# Supabase project: enable Email OTP, email confirmation, Phone confirmation + SMS provider.
SUPABASE_URL=
SUPABASE_ANON_KEY=
OWNER_EMAIL=

# Danh sách email admin hệ thống, phân cách bằng dấu phẩy. Không công khai ở client.
SYSTEM_ADMIN_EMAILS=

# Messaging is disabled by default. Use `mock` for local acceptance only.
MF_NOTIFICATION_MODE=disabled
# Production integration points. Keep both values server-side; never expose them to the browser.
MF_CUSTOMER_CARE_GATEWAY_URL=
MF_CARE_CLIENT_ID=
MF_CARE_CLIENT_SECRET=
# Opt-in only after a dedicated EXTERNAL_CONNECTOR installation and templates exist.
MF_CARE_LIVE_ENABLED=false
# Optional server-only key for a scheduled worker calling /api/notifications.
MF_NOTIFICATION_JOB_KEY=
